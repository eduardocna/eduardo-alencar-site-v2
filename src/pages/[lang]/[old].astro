---
/** Endereços antigos (v1). PT/EN: seções que viraram parte de uma sala. ES/IT: tudo vai para a página única. */
import Redirect from '../../components/Redirect.astro';
import { localePath } from '../../data/paths';
export function getStaticPaths() {
  const fullMoves: Record<string, string> = {
    briefs: 'research/#briefs', 'evidence-lab': 'research/#ferramentas', publications: 'research/#publicacoes',
    writing: 'newsletter/', teaching: 'about/#teaching', cv: 'about/#cv', contact: 'about/#contact'
  };
  const singleOld = ['about', 'book', 'research', 'briefs', 'evidence-lab', 'publications', 'newsletter', 'writing', 'teaching', 'cv', 'contact'];
  const full = ['pt', 'en'].flatMap((lang) => Object.entries(fullMoves).map(([old, to]) => ({ params: { lang, old }, props: { to: localePath(lang as 'pt', to) } })));
  const single = ['es', 'it'].flatMap((lang) => singleOld.map((old) => ({ params: { lang, old }, props: { to: localePath(lang as 'es') } })));
  return [...full, ...single];
}
const { to } = Astro.props as { to: string };
---
<Redirect to={to} lang={Astro.params.lang!} />
