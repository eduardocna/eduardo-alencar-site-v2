---
/** Endereço do site v1 que mudou de lugar: redireciona sem quebrar link antigo (GitHub Pages não tem 301). */
interface Props { to: string; lang: string; }
const { to, lang } = Astro.props;
const target = new URL(to, Astro.site).href;
---
<!doctype html>
<html lang={lang}><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>Eduardo Alencar</title>
<link rel="canonical" href={target} /><meta http-equiv="refresh" content={`0; url=${to}`} />
<script is:inline define:vars={{ to }}>const u = new URL(to, location.href); if (location.hash) u.hash = location.hash; location.replace(u.href);</script></head>
<body><p><a href={to}>Eduardo Alencar →</a></p></body></html>
