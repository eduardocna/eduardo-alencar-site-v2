---
import Base from '../layouts/Base.astro';
import { single } from '../data/content';
import { profiles, email, substackUrl, ui } from '../data/site';
import { localePath, withBase } from '../data/paths';
import { em } from '../data/text';
import Count from './Count.astro';
interface Props { lang: 'es' | 'it' }
const { lang } = Astro.props;
const c = single[lang];
---
<Base title={c.title} description={c.description} lang={lang} room="" showSubscribe={false}>
  <div class="wrap">
    <section class="home-hero">
      <div>
        <p class="eyebrow">Eduardo Alencar</p>
        <h1>{c.headline}</h1>
        {c.bio.map((p) => <p class="lede" set:html={em(p)} />)}
        <div class="actions">
          <a class="btn" href={withBase(`downloads/cv-eduardo-alencar-${lang}.pdf`)}>{c.cv}</a>
          <a class="btn ghost" href={substackUrl}>{ui[lang].subscribe}</a>
        </div>
        <p class="muted small">{c.newsletter}</p>
      </div>
      <img class="portrait" src={withBase('images/eduardo-alencar.jpg')} alt="Eduardo Alencar" width="300" height="300" />
    </section>
    <section><ul class="numbers" style="grid-template-columns:repeat(2,1fr)">{c.numbers.map(([f, l]) => <li><Count figure={f} /><span>{l}</span></li>)}</ul></section>
    <section>
      <p>{c.more} <a href={localePath('pt')} hreflang="pt">{c.pt}</a> · <a href={localePath('en')} hreflang="en">{c.en}</a></p>
      <h2>{c.contact}</h2>
      <p class="contact-links"><a href={`mailto:${email}`}>{email}</a>{profiles.map((p) => <a href={p.href} rel="me">{p.label}</a>)}</p>
    </section>
  </div>
</Base>
